 const DEFAULT_TIMEOUT: Duration = Duration::from_secs(10);
 
+#[tokio::test]
+async fn context_window_set_changes_only_the_next_turn_of_one_loaded_thread() -> Result<()> {
+    use codex_app_server_protocol::ThreadContextWindowSelection;
+    use codex_app_server_protocol::ThreadContextWindowSetParams;
+    use codex_app_server_protocol::ThreadContextWindowSetResponse;
+    use codex_app_server_protocol::ThreadTokenUsageUpdatedNotification;
+
+    let sse = create_final_assistant_message_sse_response("ok")?;
+    let server = create_mock_responses_server_sequence_unchecked(vec![sse; 4]).await;
+    let home = TempDir::new()?;
+    // Use a known catalog entry, including its actual default and maximum.
+    let catalog = codex_models_manager::bundled_models_response()?;
+    let mut model = catalog
+        .models
+        .into_iter()
+        .find(|model| model.slug == "gpt-6-astra")
+        .context("missing Astra fixture")?;
+    model.slug = "mock-model".to_owned();
+    let catalog_path = home.path().join("catalog.json");
+    std::fs::write(
+        &catalog_path,
+        serde_json::to_vec(&json!({ "models": [model] }))?,
+    )?;
+    MockResponsesConfig::new(&server.uri())
+        .with_model("mock-model")
+        .with_root_config(&format!(
+            "model_catalog_json = {}\nmodel_auto_compact_token_limit = 200000",
+            serde_json::to_string(&catalog_path)?
+        ))
+        .with_provider_config("supports_websockets = false")
+        .write(home.path())?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized_with_timeout(DEFAULT_TIMEOUT)
+        .await?;
+    let a = start_thread(&mut app).await?.thread.id;
+    let b = start_thread(&mut app).await?.thread.id;
+    assert_ne!(a, b);
+
+    async fn observe(app: &mut TestAppServer, thread: &str, expected: i64) -> Result<()> {
+        let started: TurnStartResponse = app
+            .request(|request_id| ClientRequest::TurnStart {
+                request_id,
+                params: TurnStartParams {
+                    thread_id: thread.to_owned(),
+                    input: vec![V2UserInput::Text {
+                        text: "hello".into(),
+                        text_elements: vec![],
+                    }],
+                    ..Default::default()
+                },
+            })
+            .await?;
+        let note: ThreadTokenUsageUpdatedNotification = timeout(DEFAULT_TIMEOUT, async {
+            loop {
+                let note: ThreadTokenUsageUpdatedNotification =
+                    app.read_notification("thread/tokenUsage/updated").await?;
+                if note.turn_id == started.turn.id {
+                    return Ok::<_, anyhow::Error>(note);
+                }
+            }
+        })
+        .await??;
+        assert_eq!(note.thread_id, thread);
+        assert_eq!(note.token_usage.model_context_window, Some(expected));
+        timeout(
+            DEFAULT_TIMEOUT,
+            app.read_stream_until_notification_message("turn/completed"),
+        )
+        .await??;
+        Ok(())
+    }
+    async fn select(
+        app: &mut TestAppServer,
+        thread: &str,
+        selection: ThreadContextWindowSelection,
+    ) -> Result<ThreadContextWindowSetResponse> {
+        timeout(
+            DEFAULT_TIMEOUT,
+            app.request(|request_id| ClientRequest::ThreadContextWindowSet {
+                request_id,
+                params: ThreadContextWindowSetParams {
+                    thread_id: thread.to_owned(),
+                    expected_model: "mock-model".to_owned(),
+                    selection,
+                },
+            }),
+        )
+        .await?
+    }
+
+    observe(&mut app, &a, 258_400).await?;
+    let receipt = select(&mut app, &a, ThreadContextWindowSelection::Tokens(512_000)).await?;
+    assert_eq!(receipt.thread_id, a);
+    assert_eq!(receipt.raw_tokens, Some(512_000));
+    assert_eq!(receipt.usable_tokens, Some(486_400));
+    assert_eq!(receipt.auto_compact_token_limit, Some(460_800));
+    let invalid = app
+        .send_request(
+            "thread/contextWindow/set",
+            Some(json!({
+                "threadId": a, "expectedModel": "mock-model", "selection": { "tokens": 872001 }
+            })),
+        )
+        .await?;
+    let rejection = timeout(
+        DEFAULT_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(invalid)),
+    )
+    .await??;
+    assert_eq!(rejection.error.code, -32600);
+    assert!(rejection.error.message.contains("outside model bounds"));
+    observe(&mut app, &a, 486_400).await?;
+    observe(&mut app, &b, 258_400).await?;
+    let reset = select(&mut app, &a, ThreadContextWindowSelection::Default).await?;
+    assert_eq!(reset.auto_compact_token_limit, Some(200_000));
+    observe(&mut app, &a, 258_400).await?;
+    Ok(())
+}
