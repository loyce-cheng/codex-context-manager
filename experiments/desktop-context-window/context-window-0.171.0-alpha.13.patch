+//! A selection belonging to one loaded thread and one catalog model.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ThreadWindow {
+    pub(crate) model: String,
+    pub(crate) raw_tokens: i64,
+}
+
+impl ThreadWindow {
+    pub(crate) fn compact_target(
+        &self,
+        selected_model: &str,
+        catalog_default: Option<i64>,
+        catalog_max: Option<i64>,
+        effective_percent: i64,
+    ) -> Result<i64, &'static str> {
+        if self.model != selected_model {
+            return Err("selected model changed");
+        }
+        let (Some(default), Some(max)) = (catalog_default, catalog_max) else {
+            return Err("catalog context bounds unavailable");
+        };
+        if default <= 0 || max < default || !(1..=100).contains(&effective_percent) {
+            return Err("invalid catalog context bounds");
+        }
+        if !(default..=max).contains(&self.raw_tokens) {
+            return Err("requested context window outside model bounds");
+        }
+        let usable = self
+            .raw_tokens
+            .checked_mul(effective_percent)
+            .ok_or("context window too large")?
+            / 100;
+        // Core also caps this request at 90% of the raw window.
+        let target = usable.checked_mul(95).ok_or("context window too large")? / 100;
+        if target == 0 || self.raw_tokens.checked_mul(9).is_none() {
+            return Err("invalid auto-compaction threshold");
+        }
+        Ok(target)
+    }
+}
+
+/// Called while holding the thread state lock with usage from that same state.
+pub(crate) fn commit_selection(
+    current: &mut Option<ThreadWindow>,
+    requested: Option<ThreadWindow>,
+    used: i64,
+    usable: i64,
+    compact_limit: i64,
+) -> Result<(), &'static str> {
+    if *current == requested {
+        return Ok(());
+    }
+    if used >= usable.min(compact_limit) {
+        return Err("current usage would trigger immediate compaction");
+    }
+    *current = requested;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn request(raw_tokens: i64) -> ThreadWindow {
+        ThreadWindow {
+            model: "test".into(),
+            raw_tokens,
+        }
+    }
+
+    #[test]
+    fn commit_supports_retry_reset_and_failed_shrink_without_changing_captured_settings() {
+        let mut current = None;
+        let other = current.clone();
+        let expanded = Some(request(512_000));
+        commit_selection(&mut current, expanded.clone(), 210_000, 486_400, 460_800).unwrap();
+        let captured = current.clone();
+        commit_selection(&mut current, expanded.clone(), 460_801, 486_400, 460_800).unwrap();
+        assert!(commit_selection(&mut current, None, 244_800, 258_400, 244_800).is_err());
+        assert!(
+            commit_selection(
+                &mut current,
+                Some(request(384_000)),
+                345_600,
+                364_800,
+                345_600
+            )
+            .is_err()
+        );
+        assert_eq!(current, expanded);
+        commit_selection(&mut current, None, 244_799, 258_400, 244_800).unwrap();
+        assert_eq!(current, None);
+        assert_eq!(captured, expanded);
+        assert_eq!(other, None);
+    }
+
+    #[test]
+    fn accepts_each_tier_and_respects_model_headroom() {
+        for (raw, expected) in [
+            (272_000, 245_480),
+            (384_000, 346_560),
+            (512_000, 462_080),
+            (768_000, 693_120),
+            (872_000, 786_980),
+        ] {
+            assert_eq!(
+                request(raw).compact_target("test", Some(272_000), Some(872_000), 95),
+                Ok(expected)
+            );
+        }
+        assert_eq!(
+            request(512_000).compact_target("test", Some(272_000), Some(872_000), 80),
+            Ok(389_120)
+        );
+    }
+
+    #[test]
+    fn rejects_invalid_bounds_stale_identity_and_overflow() {
+        let validate =
+            |raw, model, min, max, pct| request(raw).compact_target(model, min, max, pct);
+        for raw in [i64::MIN, 0, 271_999, 872_001, i64::MAX] {
+            assert!(validate(raw, "test", Some(272_000), Some(872_000), 95).is_err());
+        }
+        assert!(validate(512_000, "other", Some(272_000), Some(872_000), 95).is_err());
+        assert!(validate(512_000, "test", None, Some(872_000), 95).is_err());
+        assert!(validate(512_000, "test", Some(272_000), None, 95).is_err());
+        assert!(validate(512_000, "test", Some(872_000), Some(272_000), 95).is_err());
+        for pct in [-1, 0, 101] {
+            assert!(validate(512_000, "test", Some(272_000), Some(872_000), pct).is_err());
+        }
+        assert!(validate(i64::MAX, "test", Some(1), Some(i64::MAX), 100).is_err());
+    }
+}
