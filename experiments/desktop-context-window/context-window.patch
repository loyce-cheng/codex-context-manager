+    )?;
+    MockResponsesConfig::new(&server.uri())
+        .with_model("mock-model")
+        .with_root_config(&format!(
+            "model_catalog_json = {}\nmodel_auto_compact_token_limit = 200000",
+            serde_json::to_string(&catalog_path)?
+        ))
+        .with_provider_config("supports_websockets = false")
+        .write(home.path())?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized_with_timeout(DEFAULT_TIMEOUT)
+        .await?;
+    let a = start_thread(&mut app).await?.thread.id;
+    let b = start_thread(&mut app).await?.thread.id;
+    assert_ne!(a, b);
+
+    async fn observe(app: &mut TestAppServer, thread: &str, expected: i64) -> Result<()> {
+        let started: TurnStartResponse = app
+            .request(|request_id| ClientRequest::TurnStart {
+                request_id,
+                params: TurnStartParams {
+                    thread_id: thread.to_owned(),
+                    input: vec![V2UserInput::Text {
+                        text: "hello".into(),
+                        text_elements: vec![],
+                    }],
+                    ..Default::default()
+                },
+            })
+            .await?;
+        let note: ThreadTokenUsageUpdatedNotification = timeout(DEFAULT_TIMEOUT, async {
+            loop {
+                let note: ThreadTokenUsageUpdatedNotification =
