{
  "name": "codex-context-manager",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Local context monitoring for Codex, with capability-gated conversation controls.",
  "license": "MIT",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "check:desktop-compat": "node scripts/sidebar-status.mjs --compat",
    "verify:desktop-compat": "node scripts/verify-desktop-compat.mjs",
    "verify:stock-resume": "node scripts/verify-stock-resume.mjs",
    "start": "node src/server/http.mjs",
    "mcp": "node src/server/mcp.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:network": "node --test tests/http.integration.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:sidebar": "node scripts/diagnose-sidebar.mjs",
    "build:sidebar": "node scripts/build-sidebar.mjs",
    "test:sidebar": "node --test --test-isolation=none tests/sidebar.test.mjs tests/sidebar-preferences.test.mjs",
    "test:sidebar-ui": "node scripts/verify-native-sidebar.mjs",
    "test:capacity": "node --test --test-isolation=none tests/capacity.test.mjs tests/capacity-reload.test.mjs",
    "test:launcher": "node --test --test-isolation=none tests/launcher.test.mjs tests/sidebar-startup.test.mjs"
  }
}
